generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CANCELED
  COMPLETE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id            Int       @id @default(autoincrement())
  microsoftId   String    @unique
  name          String
  email         String    @unique
  isSuperAdmin  Boolean   @default(false)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())

  createdProjects Project[]           @relation("CreatedBy")
  memberships     ProjectMember[]
  invitesSent     ProjectInvite[]     @relation("InvitedBy")
  invitesAccepted ProjectInvite[]     @relation("AcceptedBy")
  assignedTasks   Task[]              @relation("AssignedTo")
  createdTasks    Task[]              @relation("TaskCreatedBy")
  statusChanges   TaskStatusHistory[]
  activityLogs    ActivityLog[]

  @@index([email])
  @@index([deactivatedAt])
  @@index([name])
}

model Project {
  id            Int           @id @default(autoincrement())
  name          String
  status        ProjectStatus @default(ACTIVE)
  deadline      DateTime?
  tags          String[]      @default([])
  description   String?
  deactivatedAt DateTime?
  createdBy     User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById   Int
  createdAt     DateTime      @default(now())

  members      ProjectMember[]
  invites      ProjectInvite[]
  tasks        Task[]
  activityLogs ActivityLog[]

  @@index([createdById])
  @@index([deactivatedAt])
  @@index([status])
  @@index([createdById, createdAt])
  @@index([tags], type: Gin)
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  role      Role     @default(MEMBER)
  isOwner   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([role])
  @@index([projectId, role, joinedAt])
}

model ProjectInvite {
  id           Int          @id @default(autoincrement())
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    Int
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById  Int
  invitedEmail String
  token        String       @unique @default(uuid())
  status       InviteStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])
  acceptedById Int?

  @@index([projectId])
  @@index([status])
  @@index([invitedEmail])
  @@index([invitedById])
  @@index([projectId, createdAt])
  @@index([projectId, invitedEmail, status])
}

model Task {
  id          Int          @id @default(autoincrement())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  title       String
  description String?
  tags        String[]     @default([])
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assignee    User?        @relation("AssignedTo", fields: [assigneeId], references: [id])
  assigneeId  Int?
  createdBy   User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById Int
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  statusHistory TaskStatusHistory[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([createdById])
  @@index([projectId, status])
  @@index([projectId, status, createdAt])
  @@index([projectId, assigneeId, status])
  @@index([projectId, dueDate, status])
  @@index([assigneeId, status, projectId])
  @@index([projectId, completedAt])
  @@index([completedAt])
  @@index([projectId, createdAt])
  @@index([tags], type: Gin)
}

model TaskStatusHistory {
  id          Int        @id @default(autoincrement())
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      Int
  changedBy   User       @relation(fields: [changedById], references: [id])
  changedById Int
  fromStatus  TaskStatus
  toStatus    TaskStatus
  changedAt   DateTime   @default(now())

  @@index([taskId])
  @@index([changedAt])
  @@index([changedById])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  action     String
  entityType String?
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId])
}
